# Copy to .env and edit. Every value below is the default unless noted.

# sample = in-memory store from sample_data/*.json (no database)
# sql    = SQLAlchemy store on DATABASE_URL
CHOTU_STORE=sample
# required when CHOTU_STORE=sql
DATABASE_URL=postgresql+psycopg://chotu:chotu@localhost:5432/chotu

# demo      = replay sample_data/telemetry_replay.json (no robot needed)
# rosbridge = connect to every robot's "endpoint" (ws://<pi>:9090)
CHOTU_ROBOT_LINK=demo
CHOTU_REPLAY_SPEED=1.0

# empty = no auth (local demo only). Set a long random value anywhere else.
CHOTU_API_KEY=
CHOTU_CORS_ORIGINS=*
