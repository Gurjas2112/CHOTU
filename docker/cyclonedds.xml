<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS profile for CHOTU: robot-local discovery, sized for the Pi 4.
     Set CYCLONEDDS_URI=file:///opt/chotu/cyclonedds.xml (done in the runtime image). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="2MB"/>
    </Internal>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>40</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
