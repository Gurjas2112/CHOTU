<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chotu_bringup</name>
  <version>2.0.0</version>
  <description>Launch files and parameters for CHOTU (real robot and Gazebo)</description>
  <maintainer email="gurjasgandhi76@gmail.com">Gurjas Singh Gandhi</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>chotu_base</exec_depend>
  <exec_depend>chotu_description</exec_depend>
  <exec_depend>chotu_navigation</exec_depend>
  <exec_depend>chotu_perception</exec_depend>
  <exec_depend>chotu_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
